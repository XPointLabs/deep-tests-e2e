      { "target": "windows", "type": "assertExactText", "purpose": "offlineNoCallbackBeforeRestore", "selector": { "role": "networkCallbackCount" }, "contains": "0" },
      { "target": "windows", "type": "click", "purpose": "restoreOpen", "selector": { "role": "welcomeRestore" } },
      { "target": "windows", "type": "setValue", "purpose": "restorePhraseEntry", "selector": { "role": "welcomeRestorePhrase" }, "value": "{{windowsRecoveryPhrase}}" },
      { "target": "windows", "type": "click", "purpose": "restoreSubmit", "selector": { "role": "welcomeRestoreSubmit" } },
      { "target": "windows", "type": "waitVisible", "purpose": "restoreConversationsReady", "selector": { "role": "conversationsRoot" }, "timeoutMs": 30000 },
      { "target": "windows", "type": "assertExactText", "purpose": "offlineNoCallbackAfterRestore", "selector": { "role": "networkCallbackCount" }, "contains": "0" },
      { "target": "windows", "type": "click", "purpose": "restoredSettingsOpen", "selector": { "role": "profileSettings" } },
      { "target": "windows", "type": "assertIdentityMatches", "purpose": "assertRestoredWindowsIdentity", "selector": { "role": "ownIdentity" }, "matches": "{{actualIdentityWindows}}" },
      { "target": "windows", "type": "click", "purpose": "restoredSettingsClose", "selector": { "role": "settingsBack" } },
      { "target": "system", "type": "restoreServicesOnline", "purpose": "offlineServicesRestore" }
    ],
    "reciprocalContact": [
