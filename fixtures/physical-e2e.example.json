      { "target": "windows", "type": "assertExactText", "purpose": "groupActiveOnWindows", "selector": { "role": "groupStateActive" }, "contains": "Active", "timeoutMs": 45000 },
      { "target": "windows", "type": "setValue", "purpose": "groupMessageEntry", "selector": { "role": "groupMessageComposer" }, "value": "{{groupMessage}}" },
      { "target": "windows", "type": "click", "purpose": "groupMessageSend", "selector": { "role": "groupMessageSend" } },
      { "target": "android", "type": "waitText", "purpose": "groupMessageReceive", "selector": { "role": "groupMessageBody" }, "contains": "{{groupMessage}}", "timeoutMs": 45000 },
      { "target": "windows", "type": "click", "purpose": "groupMembersOpen", "selector": { "role": "groupMembers" } },
      { "target": "windows", "type": "clickText", "purpose": "groupMemberSelect", "selector": { "role": "groupMemberRow" }, "contains": "{{contactMarkerAndroid}}" },
      { "target": "windows", "type": "click", "purpose": "groupRemoveMember", "selector": { "role": "groupRemove" } },
      { "target": "windows", "type": "click", "purpose": "groupRemoveConfirm", "selector": { "role": "groupRemoveConfirm" } },
      { "target": "windows", "type": "assertExactText", "purpose": "groupMemberRemovedOnWindows", "selector": { "role": "groupMemberStateRemoved" }, "contains": "Removed", "timeoutMs": 45000 },
      { "target": "android", "type": "assertExactText", "purpose": "groupRemovedOnAndroid", "selector": { "role": "groupStateRemoved" }, "contains": "Removed", "timeoutMs": 45000 },
