      { "service": "file", "url": "http://127.0.0.1:18101/health/ready", "expectedStatus": 200 },
      { "service": "push", "url": "http://127.0.0.1:18102/health/ready", "expectedStatus": 200 }
    ]
  },
  "android": {
    "serial": "192.168.1.45:43337",
    "packageName": "network.xpoint.deep.e2e",
    "launchActivity": "network.xpoint.deep.DeepLauncher",
    "apkPath": "C:\\builds\\Deep.E2E.apk",
    "attachmentDirectory": "/sdcard/Download",
